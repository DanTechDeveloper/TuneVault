<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TuneVault.ViewModels"
             xmlns:models="using:TuneVault.Models"
             xmlns:views="using:TuneVault.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="60"
             x:Class="TuneVault.Views.TrackRow"
             x:DataType="models:Track">

    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
          ColumnSpacing="10"
          Margin="4,6"
         >
        <Border Width="38"
                Height="38"
                CornerRadius="6"
                ClipToBounds="True"
                Background="{DynamicResource ElevatedBackgroundBrush}"
                VerticalAlignment="Center">
            <Panel>
                <materialIcons:MaterialIcon Kind="MusicNote"
                                           Width="16"
                                           Height="16"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !HasCoverArt}"/>
                <Image Source="{Binding CoverArt}"
                       Stretch="UniformToFill"
                       IsVisible="{Binding HasCoverArt}"/>
            </Panel>
        </Border>

        <StackPanel Grid.Column="1"
                    Spacing="3"
                    VerticalAlignment="Center">
            <TextBlock Text="▶ NOW PLAYING"
                       FontSize="{StaticResource FontSizeMd}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource NowPlayingBrush}"
                       IsVisible="{Binding IsPlaying}"/>

            <TextBlock Text="{Binding Title}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Classes.playing="{Binding IsPlaying}"/>

            <TextBlock Text="{Binding ArtistAlbum}"
                       FontSize="{StaticResource FontSizeSmMd}"
                       Opacity="0.65"/>

            <TextBlock Text="{Binding GenreDisplay}"
                       FontSize="{StaticResource FontSizeSm}"
                       Opacity="0.5"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="⚠ File not found"
                       FontSize="{StaticResource FontSizeSm}"
                       Opacity="0.75"
                       Foreground="{DynamicResource MissingFileBrush}"
                       IsVisible="{Binding IsMissing}"/>
        </StackPanel>

        <Button Grid.Column="2"
                Width="36"
                Height="36"
                Padding="0"
                CornerRadius="18"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Playback.PlayTrackCommand}"
                CommandParameter="{Binding .}"
                ToolTip.Tip="{Binding PlayPauseToolTip}">
            <materialIcons:MaterialIcon Kind="{Binding PlayPauseIconKind}" Width="22" Height="22" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" />
        </Button>

        <TextBlock Grid.Column="3"
                   Text="{Binding DurationDisplay}"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource FontSizeSmMd}"
                   Opacity="0.65"/>

        <Button Grid.Column="4"
                Content="⋮"
                Width="28"
                Height="28"
                Padding="0"
                CornerRadius="6"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Editor.EditTrackCommand}"
                CommandParameter="{Binding .}"
                ToolTip.Tip="Track info and tags"/>
    </Grid>
</UserControl>