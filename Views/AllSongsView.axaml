<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TuneVault.ViewModels"
             xmlns:models="using:TuneVault.Models"
             xmlns:views="using:TuneVault.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="500"
             x:Class="TuneVault.Views.AllSongsView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="ListBox ListBoxItem:selected">
            <Setter Property="Background" Value="#2E2E42"/>
        </Style>
        <Style Selector="ListBox ListBoxItem:selected:focus">
            <Setter Property="Background" Value="#2E2E42"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <Grid ColumnDefinitions="*,Auto"
              Margin="0,0,0,12"
              Background="#1E1E2E">
            <StackPanel Spacing="2">
                <TextBlock Text="Music Library"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock Text="{Binding Library.Tracks.Count, StringFormat='{}{0} tracks'}"
                           FontSize="12"
                           Opacity="0.6"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <ComboBox ItemsSource="{Binding Library.SortFields}"
                          SelectedItem="{Binding Library.SortField, Mode=TwoWay}"
                          Width="150"
                          IsEnabled="{Binding !Library.IsLoading}"/>
                <Button Content="{Binding Library.SortDirectionLabel}"
                        Command="{Binding Library.ToggleSortDirectionCommand}"
                        Padding="10,6"
                        IsEnabled="{Binding !Library.IsLoading}"/>
            </StackPanel>
        </Grid>

        <!-- Empty State Placeholder -->
        <Border Grid.Row="1"
                Padding="32"
                CornerRadius="10"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsVisible="{Binding Library.ShowEmptyLibrary}">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="♫"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Opacity="0.4"/>

                <TextBlock Text="Your library is empty"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Add individual audio files or import an entire folder with songs."
                           FontSize="13"
                           Opacity="0.65"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                    <Button Content="{materialIcons:MaterialIconTextExt Kind=FileMusic, Text=Add File(s)}"
                            Command="{Binding Library.AddFilesCommand}"
                            Background="#7256D9"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            Padding="14,8"/>
                    <Button Content="{materialIcons:MaterialIconTextExt Kind=FolderMusic, Text=Add Folder}"
                            Command="{Binding Library.AddFolderCommand}"
                            Background="#292943"
                            Foreground="#D8D8E0"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            Padding="14,8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Track Listing -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Library.Tracks}"
                 SelectedItem="{Binding Library.SelectedTrack, Mode=TwoWay}"
                 IsVisible="{Binding Library.HasTracks}"
                 ItemTemplate="{StaticResource TrackRowTemplate}">
        </ListBox>

        <!-- Search No Results -->
        <Border Grid.Row="1"
                Padding="32"
                CornerRadius="10"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsVisible="{Binding Library.ShowNoResults}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="No results found"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Try a different search term."
                           FontSize="13"
                           Opacity="0.65"
                           HorizontalAlignment="Center"/>
                <Button Content="{materialIcons:MaterialIconTextExt Kind=CloseCircle, Text=Clear Field}"
                        Command="{Binding Library.ClearSearchCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Padding="14,8"
                        Background="#7256D9"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        CornerRadius="8"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
