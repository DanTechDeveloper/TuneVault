
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TuneVault.ViewModels"
        xmlns:views="using:TuneVault.Views"
        xmlns:models="using:TuneVault.Models"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="620"
        x:Class="TuneVault.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TuneVault"
        Width="960"
        Height="620"
        MinWidth="760"
        MinHeight="480">

    <Window.Styles>
        <Style Selector="Button.nav-btn">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#292943"/>
            <Setter Property="Foreground" Value="#B8B8CC"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-btn:pointerover">
            <Setter Property="Background" Value="#38385A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-btn.active">
            <Setter Property="Background" Value="#292943"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel Margin="24">

        <!-- Header -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,20">

            <StackPanel Spacing="4">
                <TextBlock Text="TuneVault"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Your personal offline music library"
                           FontSize="13"
                           Opacity="0.65"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                <Button Content="＋ Add File(s)"
                        Command="{Binding Library.AddFilesCommand}"
                        Padding="14,10"/>

                <Button Content="📁 Add Folder"
                        Command="{Binding Library.AddFolderCommand}"
                        Padding="14,10"/>
            </StackPanel>
        </Grid>

        <!-- Search Bar (after header) -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">
            <TextBox Text="{Binding Library.SearchText, Mode=TwoWay}"
                     Watermark="Search title, artist, album…"
                     HorizontalAlignment="Stretch"
                     IsEnabled="{Binding !Library.IsLoading}"/>
        </Grid>
        
        <!-- Main Content: Sidebar + Library + Now Playing -->
        <Grid ColumnDefinitions="170,3*,2*"
              ColumnSpacing="16">

          <!-- LEFT SIDEBAR -->
    <Border Grid.Column="0"
        Padding="11"
        CornerRadius="10"
        Background="#FFFFFF">

    <StackPanel Spacing="8">

        <TextBlock Text="LIBRARY"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="#8888A8"
                   Margin="8,8,0,12"/>

        <!-- Navigation buttons -->
        <Button Classes="nav-btn"
                Classes.active="{Binding IsAllSongsTab}"
                Content="♫  All Songs"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.AllSongs}"/>

        <Button Classes="nav-btn"
                Classes.active="{Binding IsAlbumsTab}"
                Content="▣  Albums"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.Albums}"/>

        <Button Classes="nav-btn"
                Classes.active="{Binding IsArtistsTab}"
                Content="♙  Artists"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.Artists}"/>

        <Button Classes="nav-btn"
                Classes.active="{Binding IsGenresTab}"
                Content="☷  Genres"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.Genres}"/>

        <Border Height="1"
                Margin="4,8"
                Background="#E4E4EF"/>

        <Border Height="1"
                Margin="4,8"
                Background="#E4E4EF"/>

        <TextBlock Text="SORT BY"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="#8888A8"
                   Margin="8,0,0,4"/>

        <StackPanel Spacing="6">

            <ComboBox ItemsSource="{Binding Library.SortFields}"
                      SelectedItem="{Binding Library.SortField, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      IsEnabled="{Binding !Library.IsLoading}"/>

            <Button Content="{Binding Library.SortDirectionLabel}"
                    Command="{Binding Library.ToggleSortDirectionCommand}"
                    HorizontalAlignment="Stretch"
                    Padding="10,6"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Toggle ascending / descending"
                    IsEnabled="{Binding !Library.IsLoading}"/>
        </StackPanel>

    </StackPanel>
</Border>

            <!-- MAIN CONTENT (DYNAMIC CHILDREN) -->
            <Grid Grid.Column="1">
                <views:AllSongsView IsVisible="{Binding IsAllSongsTab}"/>
                <views:AlbumsView   IsVisible="{Binding IsAlbumsTab}"/>
                <views:ArtistsView  IsVisible="{Binding IsArtistsTab}"/>
                <views:GenresView   IsVisible="{Binding IsGenresTab}"/>
            </Grid>

          

<!-- NOW PLAYING PANEL -->
    <Border Grid.Column="2"
        Padding="22"
        CornerRadius="18"
        Background="#FFFFFF"
        BorderBrush="#E5E5EB"
        BorderThickness="1">

        <StackPanel Spacing="22">

            <!-- Album Artwork -->
            <Border
                Width="300"
                Height="300"
                CornerRadius="12"
                ClipToBounds="True"
                Background="#F1F1F5"
                HorizontalAlignment="Center">

                <Panel>
                    <TextBlock
                        Text="♪"
                        FontSize="65"
                        Foreground="#B7B7C4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !Playback.HasNowPlayingCoverArt}"/>

                    <Image
                        Source="{Binding Playback.NowPlayingCoverArt}"
                        Stretch="UniformToFill"
                        IsVisible="{Binding Playback.HasNowPlayingCoverArt}"/>
                </Panel>
            </Border>

            <!-- Track Information -->
            <StackPanel Spacing="5">
                <TextBlock
                    Text="{Binding Playback.NowPlayingTitle}"
                    FontSize="21"
                    FontWeight="Bold"
                    Foreground="#20202A"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="{Binding Playback.NowPlayingArtist}"
                    FontSize="13"
                    Foreground="#858590"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Playback Progress -->
            <StackPanel Spacing="6">

                <Slider
                    Minimum="0"
                    Maximum="{Binding Playback.DurationSeconds}"
                    Value="{Binding Playback.PositionSeconds, Mode=TwoWay}"/>

                <TextBlock
                    Text="{Binding Playback.ProgressText}"
                    FontSize="11"
                    Foreground="#858590"
                    HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- Playback Controls -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="12">
                <Button
                    Width="48"
                    Height="48"
                    Padding="0"
                    CornerRadius="24"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="#353541"
                    IsEnabled="False"
                    ToolTip.Tip="Previous (not available)">
                    <materialIcons:MaterialIcon Kind="SkipPrevious" Width="30" Height="30" Foreground="#353541" />
                </Button>

                <Button
                    Width="52"
                    Height="52"
                    Padding="0"
                    CornerRadius="26"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="#7654D6"
                    FontWeight="SemiBold"
                    Command="{Binding Playback.PlayTrackCommand}"
                    ToolTip.Tip="{Binding Playback.PlayPauseToolTip}">
                    <materialIcons:MaterialIcon Kind="{Binding Playback.PlayPauseIconKind}" Width="32" Height="32" Foreground="#7654D6" />
                </Button>

                <Button
                    Width="48"
                    Height="48"
                    Padding="0"
                    CornerRadius="24"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="#353541"
                    Command="{Binding Playback.StopCommand}"
                    ToolTip.Tip="Stop">
                    <materialIcons:MaterialIcon Kind="StopCircle" Width="30" Height="30" Foreground="#353541" />
                </Button>
            </StackPanel>

            <!-- Volume -->
            <StackPanel Spacing="8" Margin="0,4,0,0">

                <TextBlock
                    Text="VOLUME"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="#858590"/>

                <Slider
                    Minimum="0"
                    Maximum="1"
                    Value="{Binding Playback.Volume, Mode=TwoWay}"/>
            </StackPanel>


        </StackPanel>
    </Border>



        </Grid>

    </DockPanel>

        <!-- Loading Modal Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding Library.IsLoading}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320"
                    MaxWidth="460">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Importing Music"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Reading tags and decoding artwork..."
                                   FontSize="12"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Library.LoadingProgress}"
                                 Height="8"
                                 CornerRadius="4"/>

                    <TextBlock Text="{Binding Library.LoadingStatusText}"
                               FontSize="12"
                               Opacity="0.8"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Duplicate Audio Warning Modal Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding Library.ShowDuplicateModal}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320"
                    MaxWidth="480">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="⚠"
                                   FontSize="32"
                                   Foreground="#F59E0B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Library.DuplicateModalTitle}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer MaxHeight="200">
                        <TextBlock Text="{Binding Library.DuplicateModalMessage}"
                                   FontSize="13"
                                   Opacity="0.85"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <Button Content="OK"
                            HorizontalAlignment="Center"
                            MinWidth="100"
                            HorizontalContentAlignment="Center"
                            Command="{Binding Library.CloseDuplicateModalCommand}"
                            Padding="18,8"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Track Info & Metadata Editor Modal Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding Editor.IsEditMetadataModalOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="420"
                    MaxWidth="540">
                <StackPanel Spacing="16">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Edit Track Info"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Modify tags and embedded album art"
                                       FontSize="12"
                                       Opacity="0.65"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕"
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding Editor.CancelEditMetadataCommand}"/>
                    </Grid>

                    <ScrollViewer MaxHeight="380">
                        <StackPanel Spacing="14">
                            <!-- Album Art Section -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalAlignment="Center">
                                <Border Width="88"
                                        Height="88"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="#222238">
                                    <Panel>
                                        <TextBlock Text="♫"
                                                   FontSize="36"
                                                   Foreground="#8888A8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !Editor.HasEditCoverArt}"/>
                                        <Image Source="{Binding Editor.EditCoverArtBitmap}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding Editor.HasEditCoverArt}"/>
                                    </Panel>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Album Artwork" FontWeight="SemiBold" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="📁 Choose Image"
                                                Padding="10,6"
                                                FontSize="12"
                                                Command="{Binding Editor.ChooseCoverArtCommand}"/>
                                        <Button Content="🗑 Remove"
                                                Padding="10,6"
                                                FontSize="12"
                                                IsVisible="{Binding Editor.HasEditCoverArt}"
                                                Command="{Binding Editor.RemoveCoverArtCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="Supports JPG, PNG, WEBP, BMP" FontSize="11" Opacity="0.55"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.2"/>

                            <!-- Metadata Fields -->
                            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Editor.EditTitle, Mode=TwoWay}" Watermark="Song title"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Artist" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Editor.EditArtist, Mode=TwoWay}" Watermark="Artist name"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Album" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Editor.EditAlbum, Mode=TwoWay}" Watermark="Album title"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Genre" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Editor.EditGenre, Mode=TwoWay}" Watermark="Music genre"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Year" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Editor.EditYear, Mode=TwoWay}" Watermark="Release year"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.2"/>

                            <!-- Read-only Audio Details -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Editor.EditDuration, StringFormat='Duration: {0}'}"
                                           FontSize="11"
                                           Opacity="0.6"/>
                                <TextBlock Text="{Binding Editor.EditFilePath, StringFormat='Location: {0}'}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Actions -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10"
                                Margin="0,4,0,0">
                        <Button Content="Cancel"
                                MinWidth="80"
                                Command="{Binding Editor.CancelEditMetadataCommand}"
                                Padding="14,8"/>
                        <Button Content="Save Changes"
                                MinWidth="110"
                                Command="{Binding Editor.SaveTrackMetadataCommand}"
                                Padding="16,8"
                                FontWeight="SemiBold"/>
                        <Button Content="🗑 Delete"
                                Command="{Binding Editor.RequestRemoveEditingTrackCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Delete Track Confirmation Modal Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding Library.ShowDeleteConfirmation}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="360"
                    MaxWidth="460">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="🗑"
                                   FontSize="32"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Delete Track?"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Library.DeleteConfirmationMessage}"
                               FontSize="13"
                               Opacity="0.85"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <Button Content="Cancel"
                                MinWidth="100"
                                HorizontalContentAlignment="Center"
                                Command="{Binding Library.CancelRemoveTrackCommand}"
                                Padding="18,8"/>
                        <Button Content="Delete"
                                MinWidth="100"
                                HorizontalContentAlignment="Center"
                                Command="{Binding Library.ConfirmRemoveTrackCommand}"
                                Padding="18,8"
                                Background="#C0392B"
                                Foreground="White"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
