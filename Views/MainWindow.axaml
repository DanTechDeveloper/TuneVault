
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TuneVault.ViewModels"
        xmlns:views="using:TuneVault.Views"
        xmlns:models="using:TuneVault.Models"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="620"
        x:Class="TuneVault.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TuneVault"
        Width="960"
        Height="620"
        MinWidth="760"
        MinHeight="480">

    <Window.Styles>
        <Style Selector="Button.nav-btn">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#292943"/>
            <Setter Property="Foreground" Value="#B8B8CC"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-btn:pointerover">
            <Setter Property="Background" Value="#38385A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-btn.active">
            <Setter Property="Background" Value="#292943"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel Margin="24">

        <!-- Header -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,20">

            <StackPanel Spacing="4">
                <TextBlock Text="TuneVault"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Your personal offline music library"
                           FontSize="13"
                           Opacity="0.65"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                <Button Content="＋ Add File(s)"
                        Command="{Binding AddFilesCommand}"
                        Padding="14,10"/>

                <Button Content="📁 Add Folder"
                        Command="{Binding AddFolderCommand}"
                        Padding="14,10"/>
            </StackPanel>
        </Grid>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="12,8"
                CornerRadius="6"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"/>
        </Border>

        <!-- Main Content: Sidebar + Library + Now Playing -->
        <Grid ColumnDefinitions="170,3*,2*"
              ColumnSpacing="16">

          <!-- LEFT SIDEBAR -->
    <Border Grid.Column="0"
        Padding="11"
        CornerRadius="10"
        Background="#FFFFFF">

    <StackPanel Spacing="8">

        <TextBlock Text="LIBRARY"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="#8888A8"
                   Margin="8,8,0,12"/>

        <!-- Navigation buttons -->
        <Button Classes="nav-btn"
                Classes.active="{Binding IsAllSongsTab}"
                Content="♫  All Songs"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.AllSongs}"/>

        <Button Classes="nav-btn"
                Classes.active="{Binding IsAlbumsTab}"
                Content="▣  Albums"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.Albums}"/>

        <Button Classes="nav-btn"
                Classes.active="{Binding IsArtistsTab}"
                Content="♙  Artists"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.Artists}"/>

        <Button Classes="nav-btn"
                Classes.active="{Binding IsGenresTab}"
                Content="☷  Genres"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.Genres}"/>

    </StackPanel>
</Border>

            <!-- MAIN CONTENT (DYNAMIC CHILDREN) -->
            <Grid Grid.Column="1">
                <views:AllSongsView IsVisible="{Binding IsAllSongsTab}"/>
                <views:AlbumsView   IsVisible="{Binding IsAlbumsTab}"/>
                <views:ArtistsView  IsVisible="{Binding IsArtistsTab}"/>
                <views:GenresView   IsVisible="{Binding IsGenresTab}"/>
            </Grid>

            <!-- NOW PLAYING PANEL -->
            <ScrollViewer Grid.Column="2">

                <StackPanel Spacing="16">

                    <Border Padding="20"
                            CornerRadius="10"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                        <StackPanel Spacing="14">

                            <TextBlock Text="NOW PLAYING"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       Opacity="0.6"/>

                            <!-- Album Art -->
                            <Border Width="180"
                                    Height="180"
                                    CornerRadius="10"
                                    ClipToBounds="True"
                                    Background="#222238"
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,6">
                                <Panel>
                                    <TextBlock Text="♫"
                                               FontSize="56"
                                               Foreground="#8888A8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !HasNowPlayingCoverArt}"/>
                                    <Image Source="{Binding NowPlayingCoverArt}"
                                           Stretch="UniformToFill"
                                           IsVisible="{Binding HasNowPlayingCoverArt}"/>
                                </Panel>
                            </Border>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding NowPlayingTitle}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding NowPlayingArtist}"
                                           FontSize="13"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Playback Progress -->
                            <StackPanel Spacing="4">
                                <Slider Minimum="0"
                                        Maximum="{Binding DurationSeconds}"
                                        Value="{Binding PositionSeconds, Mode=TwoWay}"/>

                                <TextBlock Text="{Binding ProgressText}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           Opacity="0.65"/>
                            </StackPanel>

                            <!-- Playback Controls -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="10">

                                <Button Content="Play / Pause"
                                        MinWidth="110"
                                        Command="{Binding PlayPauseCommand}"/>

                                <Button Content="Stop"
                                        MinWidth="70"
                                        Command="{Binding StopCommand}"/>
                            </StackPanel>

                            <!-- Volume -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Volume"
                                           FontSize="12"
                                           Opacity="0.7"/>

                                <Slider Minimum="0"
                                        Maximum="1"
                                        Value="{Binding Volume, Mode=TwoWay}"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Library Actions -->
                    <Border Padding="16"
                            CornerRadius="10"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                        <StackPanel Spacing="10">
                            <TextBlock Text="Track Management"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>

                            <Button Content="Remove Selected Track"
                                    Command="{Binding RemoveTrackCommand}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Supported formats: WAV, MP3, FLAC, OGG, Opus and AIFF."
                               FontSize="11"
                               Opacity="0.55"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </ScrollViewer>

        </Grid>

    </DockPanel>

        <!-- Loading Modal Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding IsLoading}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320"
                    MaxWidth="460">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Importing Music"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Reading tags and decoding artwork..."
                                   FontSize="12"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding LoadingProgress}"
                                 Height="8"
                                 CornerRadius="4"/>

                    <TextBlock Text="{Binding LoadingStatusText}"
                               FontSize="12"
                               Opacity="0.8"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
