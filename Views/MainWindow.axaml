
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TuneVault.ViewModels"
        xmlns:views="using:TuneVault.Views"
        xmlns:models="using:TuneVault.Models"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="620"
        x:Class="TuneVault.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TuneVault"
        Width="960"
        Height="620"
        MinWidth="760"
        MinHeight="480">

    <Window.Styles>
        <Style Selector="Button.nav-btn">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#292943"/>
            <Setter Property="Foreground" Value="#B8B8CC"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-btn:pointerover">
            <Setter Property="Background" Value="#38385A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav-btn.active">
            <Setter Property="Background" Value="#292943"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel Margin="24">

        <!-- Header -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,20">

            <StackPanel Spacing="4">
                <TextBlock Text="TuneVault"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Your personal offline music library"
                           FontSize="13"
                           Opacity="0.65"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                <Button Content="{materialIcons:MaterialIconTextExt Kind=FileMusic, Text=Add File(s)}"
                        Command="{Binding Library.AddFilesCommand}"
                        Background="#7256D9"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        CornerRadius="8"
                        Padding="14,10"/>

                <Button Content="{materialIcons:MaterialIconTextExt Kind=FolderMusic, Text=Add Folder}"
                        Command="{Binding Library.AddFolderCommand}"
                        Background="#292943"
                        Foreground="#D8D8E0"
                        FontWeight="SemiBold"
                        CornerRadius="8"
                        Padding="14,10"/>
            </StackPanel>
        </Grid>

        <!-- Search Bar (after header) -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,16">
            <TextBox Text="{Binding Library.SearchText, Mode=TwoWay}"
                     Watermark="Search title, artist, album…"
                     HorizontalAlignment="Stretch"
                     IsEnabled="{Binding !Library.IsLoading}"/>
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="10,6"
                    Background="#292943"
                    Foreground="#D8D8E0"
                    CornerRadius="8"
                    ToolTip.Tip="Clear search"
                    IsVisible="{Binding Library.ShowNoResults}"
                    Command="{Binding Library.ClearSearchCommand}">
                <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16"/>
            </Button>
        </Grid>
        
        <!-- Main Content: Sidebar + Library + Now Playing -->
        <Grid ColumnDefinitions="170,3*,2*"
              ColumnSpacing="16">

          <!-- LEFT SIDEBAR -->
    <Border Grid.Column="0"
        Padding="11"
        CornerRadius="10"
        Background="#1E1E2E">

    <StackPanel Spacing="8">

        <TextBlock Text="LIBRARY"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="#8888A8"
                   Margin="8,8,0,12"/>

        <!-- Navigation buttons -->
        <Button Classes="nav-btn"
                Classes.active="{Binding IsAllSongsTab}"
                Content="{materialIcons:MaterialIconTextExt Kind=MusicNote, Text=All Songs}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.AllSongs}"/>

        <Button Classes="nav-btn"
                Classes.active="{Binding IsAlbumsTab}"
                Content="{materialIcons:MaterialIconTextExt Kind=Album, Text=Albums}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.Albums}"/>

        <Button Classes="nav-btn"
                Classes.active="{Binding IsArtistsTab}"
                Content="{materialIcons:MaterialIconTextExt Kind=Person, Text=Artists}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.Artists}"/>

        <Button Classes="nav-btn"
                Classes.active="{Binding IsAlbumArtists}"
                Content="{materialIcons:MaterialIconTextExt Kind=PersonMultiple, Text=Album Artists}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.AlbumArtists}"/>

        <Button Classes="nav-btn"
                Classes.active="{Binding IsGenresTab}"
                Content="{materialIcons:MaterialIconTextExt Kind=Category, Text=Genres}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:NavigationTab.Genres}"/>

        <Border Height="1"
                Margin="4,8"
                Background="#333344"/>

    </StackPanel>
</Border>

            <!-- MAIN CONTENT (DYNAMIC CHILDREN) -->
            <Border Grid.Column="1"
                    CornerRadius="18"
                    ClipToBounds="True"
                    Background="#1E1E2E"
                    Padding="12">
                <Grid>
                    <views:AllSongsView IsVisible="{Binding IsAllSongsTab}"/>
                    <views:AlbumsView   IsVisible="{Binding IsAlbumsTab}"/>
                    <views:AlbumArtistsView IsVisible="{Binding IsAlbumArtists}"/>
                    <views:ArtistsView  IsVisible="{Binding IsArtistsTab}"/>
                    <views:GenresView   IsVisible="{Binding IsGenresTab}"/>
                </Grid>
            </Border>

          

<!-- NOW PLAYING PANEL -->
    <Border Grid.Column="2"
        Padding="0"
        CornerRadius="18"
        ClipToBounds="True"
        Background="#1A1A2E"
        BorderBrush="#333344"
        BorderThickness="1">

        <Grid>
            <!-- Blurred album art background -->
            <Image
                Source="{Binding Playback.NowPlayingCoverArt}"
                Stretch="UniformToFill"
                IsVisible="{Binding Playback.HasNowPlayingCoverArt}">
                <Image.Effect>
                    <BlurEffect Radius="100"/>
                </Image.Effect>
            </Image>

            <!-- Readability scrim -->
            <Border Background="#70000000"/>

            <!-- Content -->
            <StackPanel Spacing="22" Margin="22">

            <!-- Album Artwork -->
            <Border
                Width="300"
                Height="300"
                CornerRadius="12"
                ClipToBounds="True"
                Background="#2A2A3E"
                HorizontalAlignment="Center">

                <Panel>
                    <TextBlock
                        Text="♪"
                        FontSize="65"
                        Foreground="#8888A8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !Playback.HasNowPlayingCoverArt}"/>

                    <Image
                        Source="{Binding Playback.NowPlayingCoverArt}"
                        Stretch="UniformToFill"
                        IsVisible="{Binding Playback.HasNowPlayingCoverArt}"/>
                </Panel>
            </Border>

            <!-- Track Information -->
            <StackPanel Spacing="5">
                <TextBlock
                    Text="{Binding Playback.NowPlayingTitle}"
                    FontSize="21"
                    FontWeight="Bold"
                    Foreground="#FFFFFF"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="{Binding Playback.NowPlayingArtist}"
                    FontSize="13"
                    Foreground="#ffffffff"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Playback Progress -->
            <StackPanel Spacing="6">

               <Slider
    Minimum="0"
    Maximum="{Binding Playback.DurationSeconds}"
    Value="{Binding Playback.PositionSeconds, Mode=TwoWay}"
    Background="#D5D3DE"
    Foreground="#7256D9"/>

<TextBlock
    Text="{Binding Playback.ProgressText}"
    FontSize="11"
    FontWeight="Bold"
    Foreground="#ffffffff"
    HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- Playback Controls -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="12">
                <Button
                    Width="60"
                    Height="60"
                    Padding="0"
                    CornerRadius="24"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="#ffffffff"
                    Command="{Binding Playback.PreviousCommand}"
                    ToolTip.Tip="Previous">
                    <materialIcons:MaterialIcon Kind="SkipPrevious" Width="30" Height="30" Foreground="#ffffffff" />
                </Button>

                <Button
                    Width="60"
                    Height="60"
                    Padding="0"
                    CornerRadius="26"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    FontWeight="SemiBold"
                    Command="{Binding Playback.PlayTrackCommand}"
                    ToolTip.Tip="{Binding Playback.PlayPauseToolTip}">
                    <materialIcons:MaterialIcon Kind="{Binding Playback.PlayPauseIconKind}" Width="32" Height="32" Foreground="#ffffffff" />
                </Button>

                <Button
                    Width="60"
                    Height="60"
                    Padding="0"
                    CornerRadius="24"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    Foreground="#ffffffff"
                    Command="{Binding Playback.NextCommand}"
                    ToolTip.Tip="Next">
                    <materialIcons:MaterialIcon Kind="SkipNext" Width="30" Height="30" Foreground="#ffffffff" />
                </Button>
            </StackPanel>

            <!-- Volume -->
            <StackPanel Spacing="8" Margin="0,4,0,0">

                <TextBlock
                    Text="VOLUME"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="#ffffffff"/>

                <Slider
                    Minimum="0"
                    Maximum="1"
                    Value="{Binding Playback.Volume, Mode=TwoWay}"
                    Background="#D5D3DE"
                    Foreground="#7256D9"/>
            </StackPanel>


        </StackPanel>
        </Grid>
    </Border>



        </Grid>

    </DockPanel>

        <!-- Success Toast Overlay (bottom-right, auto-dismisses) -->
        <Border IsVisible="{Binding Library.ShowToast}"
                Background="#1E1E2E"
                BorderBrush="#333344"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                MinWidth="280"
                MaxWidth="380"
                BoxShadow="0 8 24 0 #40000000"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="24">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                <Image Source="{Binding Library.ToastCover}"
                       Width="56"
                       Height="56"
                       Stretch="UniformToFill"
                       VerticalAlignment="Center"
                       IsVisible="{Binding Library.ToastCover, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>

                <materialIcons:MaterialIcon Kind="CheckCircle"
                                            Width="28"
                                            Height="28"
                                            Foreground="#2ECC71"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding Library.ToastCover, Converter={x:Static conv:ObjectConverters.IsNull}}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Library.ToastTitle}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding Library.ToastMessage}"
                               FontSize="11"
                               Opacity="0.85"
                               Foreground="#D8D8E0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="#292943"
                        CornerRadius="6"
                        Command="{Binding Library.CloseToastCommand}"
                        ToolTip.Tip="Dismiss">
                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="#D8D8E0"/>
                </Button>
            </Grid>
        </Border>

        <!-- Loading Modal Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding Library.IsLoading}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320"
                    MaxWidth="460">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Importing Music"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Reading tags and decoding artwork..."
                                   FontSize="12"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Library.LoadingProgress}"
                                 Height="8"
                                 CornerRadius="4"/>

                    <TextBlock Text="{Binding Library.LoadingStatusText}"
                               FontSize="12"
                               Opacity="0.8"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Duplicate Audio Warning Modal Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding Library.ShowDuplicateModal}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320"
                    MaxWidth="480">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="⚠"
                                   FontSize="32"
                                   Foreground="#F59E0B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Library.DuplicateModalTitle}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer MaxHeight="200">
                        <TextBlock Text="{Binding Library.DuplicateModalMessage}"
                                   FontSize="13"
                                   Opacity="0.85"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <Button Content="OK"
                            HorizontalAlignment="Center"
                            MinWidth="100"
                            HorizontalContentAlignment="Center"
                            Command="{Binding Library.CloseDuplicateModalCommand}"
                            Padding="18,8"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Track Info & Metadata Editor Modal Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding Editor.IsEditMetadataModalOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="420"
                    MaxWidth="540">
                <StackPanel Spacing="16">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Edit Track Info"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Modify tags and embedded album art"
                                       FontSize="12"
                                       Opacity="0.65"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="28"
                                Height="28"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="#292943"
                                CornerRadius="8"
                                Command="{Binding Editor.CancelEditMetadataCommand}">
                            <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="#D8D8E0"/>
                        </Button>
                    </Grid>

                    <ScrollViewer MaxHeight="380">
                        <StackPanel Spacing="14">
                            <!-- Album Art Section -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalAlignment="Center">
                                <Border Width="88"
                                        Height="88"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="#222238">
                                    <Panel>
                                        <materialIcons:MaterialIcon Kind="MusicNote"
                                                                     Width="40"
                                                                     Height="40"
                                                                     Foreground="#8888A8"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     IsVisible="{Binding !Editor.HasEditCoverArt}"/>
                                        <Image Source="{Binding Editor.EditCoverArtBitmap}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding Editor.HasEditCoverArt}"/>
                                    </Panel>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Album Artwork" FontWeight="SemiBold" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{materialIcons:MaterialIconTextExt Kind=PhotoLibrary, Text=Choose Image}"
                                                Padding="10,6"
                                                FontSize="12"
                                                Background="#292943"
                                                Foreground="#D8D8E0"
                                                CornerRadius="8"
                                                Command="{Binding Editor.ChooseCoverArtCommand}"/>
                                        <Button Content="{materialIcons:MaterialIconTextExt Kind=ImageRemove, Text=Remove}"
                                                Padding="10,6"
                                                FontSize="12"
                                                Background="#292943"
                                                Foreground="#D8D8E0"
                                                CornerRadius="8"
                                                IsVisible="{Binding Editor.HasEditCoverArt}"
                                                Command="{Binding Editor.RemoveCoverArtCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="Supports JPG, PNG, WEBP, BMP" FontSize="11" Opacity="0.55"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.2"/>

                            <!-- Metadata Fields -->
                            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Editor.EditTitle, Mode=TwoWay}" Watermark="Song title"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Artist" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Editor.EditArtist, Mode=TwoWay}" Watermark="Artist name"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Album" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Editor.EditAlbum, Mode=TwoWay}" Watermark="Album title"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Genre" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Editor.EditGenre, Mode=TwoWay}" Watermark="Music genre"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Year" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Editor.EditYear, Mode=TwoWay}" Watermark="Release year"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.2"/>

                            <!-- Read-only Audio Details -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Editor.EditDuration, StringFormat='Duration: {0}'}"
                                           FontSize="11"
                                           Opacity="0.6"/>
                                <TextBlock Text="{Binding Editor.EditFilePath, StringFormat='Location: {0}'}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Actions -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10"
                                Margin="0,4,0,0">
                        <Button Content="{materialIcons:MaterialIconTextExt Kind=Cancel, Text=Cancel}"
                                MinWidth="80"
                                HorizontalContentAlignment="Center"
                                Background="#292943"
                                Foreground="#D8D8E0"
                                CornerRadius="8"
                                Command="{Binding Editor.CancelEditMetadataCommand}"
                                Padding="14,8"/>
                        <Button Content="{materialIcons:MaterialIconTextExt Kind=ContentSave, Text=Save Changes}"
                                MinWidth="110"
                                HorizontalContentAlignment="Center"
                                Background="#7256D9"
                                Foreground="#FFFFFF"
                                CornerRadius="8"
                                Command="{Binding Editor.SaveTrackMetadataCommand}"
                                Padding="16,8"
                                FontWeight="SemiBold"/>
                        <Button Content="{materialIcons:MaterialIconTextExt Kind=Delete, Text=Delete}"
                                Background="#C0392B"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="14,8"
                                FontWeight="SemiBold"
                                Command="{Binding Editor.RequestRemoveEditingTrackCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Delete Track Confirmation Modal Overlay -->
        <Border Background="#80000000"
                IsVisible="{Binding Library.ShowDeleteConfirmation}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 8 32 0 #40000000"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="360"
                    MaxWidth="460">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="DeleteOutline"
                                                     Width="40"
                                                     Height="40"
                                                     Foreground="#C0392B"
                                                     HorizontalAlignment="Center"/>
                        <TextBlock Text="Delete Track?"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Library.DeleteConfirmationMessage}"
                               FontSize="13"
                               Opacity="0.85"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <Button Content="{materialIcons:MaterialIconTextExt Kind=Cancel, Text=Cancel}"
                                MinWidth="100"
                                HorizontalContentAlignment="Center"
                                Command="{Binding Library.CancelRemoveTrackCommand}"
                                Background="#292943"
                                Foreground="#D8D8E0"
                                CornerRadius="8"
                                Padding="18,8"/>
                        <Button Content="{materialIcons:MaterialIconTextExt Kind=Delete, Text=Delete}"
                                MinWidth="100"
                                HorizontalContentAlignment="Center"
                                Command="{Binding Library.ConfirmRemoveTrackCommand}"
                                Padding="18,8"
                                Background="#C0392B"
                                Foreground="White"
                                CornerRadius="8"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
