<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TuneVault.ViewModels"
             xmlns:models="using:TuneVault.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="380"
             d:DesignHeight="480"
             x:Class="TuneVault.Views.LyricsView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.lyric">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeXl}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.25"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.lyric.active">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="0,0,0,4">

        <!-- Header: back + full TrackRow-style metadata, left aligned -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,10">
            <Button Width="32"
                    Height="32"
                    Padding="0"
                    CornerRadius="16"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    Command="{Binding Playback.CloseLyricsCommand}"
                    ToolTip.Tip="Back to player">
                <materialIcons:MaterialIcon Kind="ArrowBack" Width="20" Height="20"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>

            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                  VerticalAlignment="Center"
                  IsVisible="{Binding Playback.HasNowPlayingTrack}">
                <!-- Cover art, TrackRow-style tile with MusicNote fallback -->
                <Border Width="64"
                        Height="64"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Background="{DynamicResource ElevatedBackgroundBrush}">
                    <Panel>
                        <materialIcons:MaterialIcon Kind="MusicNote"
                                                   Width="24"
                                                   Height="24"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !Playback.HasNowPlayingCoverArt}"/>
                        <Image Source="{Binding Playback.NowPlayingCoverArt}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding Playback.HasNowPlayingCoverArt}"/>
                    </Panel>
                </Border>

                <!-- Metadata stays vertical, like a TrackRow text stack -->
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Playback.NowPlayingTrack.Title}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2"/>

                    <TextBlock Text="{Binding Playback.NowPlayingTrack.ArtistAlbum}"
                               FontSize="{StaticResource FontSizeSmMd}"
                               Opacity="0.65"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2"/>

                    <TextBlock Text="{Binding Playback.NowPlayingTrack.GenreDisplay}"
                               FontSize="{StaticResource FontSizeSm}"
                               Opacity="0.5"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2"/>

                    <TextBlock Text="⚠ File not found"
                               FontSize="{StaticResource FontSizeSm}"
                               Opacity="0.75"
                               Foreground="{DynamicResource MissingFileBrush}"
                               IsVisible="{Binding Playback.NowPlayingTrack.IsMissing}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Lines / empty state -->
        <Grid Grid.Row="1">
            <ListBox x:Name="LyricsList"
                     ItemsSource="{Binding Playback.Lyrics}"
                     SelectedItem="{Binding Playback.ActiveLyricLine, Mode=TwoWay}"
                     AutoScrollToSelectedItem="False"
                     IsVisible="{Binding Playback.HasLyrics}"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:LyricLine">
                        <TextBlock Classes="lyric"
                                   Classes.active="{Binding IsActive}"
                                   Text="{Binding Text}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Spacing="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !Playback.HasLyrics}">
                <materialIcons:MaterialIcon Kind="QueueMusic"
                                           Width="44"
                                           Height="44"
                                           HorizontalAlignment="Center"
                                           Opacity="0.4"/>
                <TextBlock Text="No lyrics for this track"
                           FontSize="{StaticResource FontSizeMd}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"/>
                <TextBlock Text="Add a .lrc file next to the audio file."
                           FontSize="{StaticResource FontSizeSm}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
